const { chromium } = require('playwright');
const https = require('https');
const http = require('http');

// --- SECURE CONFIGURATION ---
const PRODUCT_URL = 'https://amzn.in/d/01K4h56l'; 
const WHATSAPP_PHONE = process.env.WHATSAPP_PHONE;     // Read securely from the cloud server
const WHATSAPP_API_KEY = process.env.WHATSAPP_API_KEY; // Read securely from the cloud server
// ----------------------------

// Keep-alive server for Render's Free Tier
http.createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'text/plain' });
  res.end('Monitor is running securely in the background!\n');
}).listen(process.env.PORT || 3000);

function sendWhatsAppNotification(message) {
  // Prevent execution if environment variables are missing
  if (!WHATSAPP_PHONE || !WHATSAPP_API_KEY) {
    console.error('[WhatsApp Error]: Missing secure environment variables!');
    return;
  }

  const encodedMessage = encodeURIComponent(message);
  const cleanPhone = WHATSAPP_PHONE.replace('+', '');
  const url = `https://callmebot.com{cleanPhone}&text=${encodedMessage}&apikey=${WHATSAPP_API_KEY}`;

  https.get(url, (res) => {
    let data = '';
    res.on('data', (chunk) => { data += chunk; });
    res.on('end', () => {
      console.log(`[WhatsApp Status]: Secure message dispatched.`);
    });
  }).on("error", (err) => {
    console.error("[WhatsApp Error]: " + err.message);
  });
}

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

async function monitorProduct() {
  console.log('🚀 Secure Cloud PS5 Monitor Initializing...');
  const browser = await chromium.launch({ headless: true });
  const context = await browser.newContext({
    userAgent: 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36'
  });
  const page = await context.newPage();

  while (true) {
    try {
      await page.goto(PRODUCT_URL, { waitUntil: 'domcontentloaded', timeout: 45000 });

      const outOfStockElement = await page.$('#outOfStock, .a-color-price:has-text("Currently unavailable")');

      if (outOfStockElement) {
        console.log(`[${new Date().toLocaleTimeString()}] ❌ PS5 Slim is still out of stock.`);
      } else {
        const alertMsg = `🚨 ALERT! SONY PS5 SLIM MIGHT BE IN STOCK! 🚨\nBuy immediately here: ${PRODUCT_URL}`;
        console.log(`\n${alertMsg}\n`);
        
        sendWhatsAppNotification(alertMsg);
      }
    } catch (error) {
      console.error(`[${new Date().toLocaleTimeString()}] ⚠️ Error:`, error.message);
    }

    const randomInterval = 5000 + Math.floor(Math.random() * 3000);
    await delay(randomInterval);
  }
}

monitorProduct();
